{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "ASATECHID Commerce",
		"description": "Storefront catalogue and education hub. Phase 0 scaffold with DEMO content only.",
		"author": "ASATECHID"
	},
	"settings": {
		"title": "ASATECHID Commerce",
		"tagline": "Katalog produk dan pusat edukasi (DEMO)",
		"seo": {
			"titleSeparator": " — "
		}
	},
	"collections": [
		{
			"slug": "posts",
			"label": "Artikel",
			"labelSingular": "Artikel",
			"description": "Artikel editorial: panduan, catatan, dan penjelasan. Penulis memakai byline EmDash; kategori dan tag memakai taxonomy.",
			"urlPattern": "/posts/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"scheduling",
				"search",
				"seo"
			],
			"titleField": "title",
			"admin": {
				"listColumns": [
					"title"
				]
			},
			"fields": [
				{
					"slug": "title",
					"label": "Judul",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Gambar utama",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "Konten",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Ringkasan",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "related_posts",
					"label": "Artikel terkait",
					"type": "reference",
					"validation": {
						"targetCollection": "posts",
						"multiple": true
					}
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		},
		{
			"slug": "brands",
			"label": "Merek",
			"labelSingular": "Merek",
			"description": "Merek produk. Belum ada halaman publik pada fase ini.",
			"routable": false,
			"supports": [
				"drafts",
				"revisions"
			],
			"admin": {
				"listColumns": [
					"name"
				]
			},
			"fields": [
				{
					"slug": "name",
					"label": "Nama merek",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "description",
					"label": "Deskripsi",
					"type": "text"
				},
				{
					"slug": "logo",
					"label": "Logo",
					"type": "image"
				},
				{
					"slug": "website",
					"label": "Situs web",
					"type": "url"
				}
			]
		},
		{
			"slug": "products",
			"label": "Produk",
			"labelSingular": "Produk",
			"description": "Katalog produk. Harga, mata uang, ketersediaan, dan SKU hanya diisi bila datanya valid.",
			"urlPattern": "/products/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"scheduling",
				"search",
				"seo"
			],
			"titleField": "title",
			"admin": {
				"listColumns": [
					"title",
					"availability",
					"featured"
				]
			},
			"fields": [
				{
					"slug": "title",
					"label": "Nama produk",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Ringkasan",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "description",
					"label": "Deskripsi",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Gambar utama",
					"type": "image"
				},
				{
					"slug": "brand",
					"label": "Merek",
					"type": "reference",
					"validation": {
						"targetCollection": "brands",
						"multiple": false
					}
				},
				{
					"slug": "related_products",
					"label": "Produk terkait",
					"type": "reference",
					"validation": {
						"targetCollection": "products",
						"multiple": true
					}
				},
				{
					"slug": "specifications",
					"label": "Spesifikasi",
					"type": "repeater",
					"validation": {
						"minItems": 0,
						"maxItems": 20,
						"subFields": [
							{
								"slug": "label",
								"label": "Label",
								"type": "string",
								"required": true
							},
							{
								"slug": "value",
								"label": "Nilai",
								"type": "text",
								"required": true
							}
						]
					}
				},
				{
					"slug": "price",
					"label": "Harga",
					"type": "number",
					"validation": {
						"min": 0
					}
				},
				{
					"slug": "currency",
					"label": "Mata uang (ISO 4217)",
					"type": "string",
					"validation": {
						"maxLength": 3
					}
				},
				{
					"slug": "availability",
					"label": "Ketersediaan",
					"type": "select",
					"validation": {
						"options": [
							"Tersedia",
							"Tidak tersedia",
							"Pre-order"
						]
					}
				},
				{
					"slug": "sku",
					"label": "SKU",
					"type": "string"
				},
				{
					"slug": "featured",
					"label": "Produk pilihan",
					"type": "boolean",
					"indexed": true,
					"defaultValue": false
				}
			]
		}
	],
