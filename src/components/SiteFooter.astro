---
import Logo from "./Logo.astro";

interface Props {
	siteTitle: string;
	siteTagline?: string;
}

const { siteTitle, siteTagline } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container site-footer__inner">
		<div class="site-footer__brand">
			<Logo title={siteTitle} />
			{siteTagline && <p class="site-footer__tagline">{siteTagline}</p>}
			<p class="site-footer__availability">
				Informasi harga dan ketersediaan hanya tampil saat data sudah diverifikasi.
			</p>
		</div>

		<nav class="site-footer__nav" aria-label="Navigasi katalog">
			<h2 class="site-footer__heading">Katalog</h2>
			<ul>
				<li><a href="/products">Semua produk</a></li>
				<li><a href="/posts">Artikel dan panduan</a></li>
			</ul>
		</nav>

		<nav class="site-footer__nav" aria-label="Navigasi perusahaan">
			<h2 class="site-footer__heading">Perusahaan</h2>
			<ul>
				<li><a href="/about">Tentang</a></li>
				<li><a href="/">Beranda</a></li>
			</ul>
		</nav>
	</div>

	<div class="container site-footer__bottom">
		<p>© {year} {siteTitle}. Semua hak dilindungi.</p>
	</div>
</footer>

<style>
	.site-footer {
		padding-top: var(--space-12);
		background: var(--color-header);
		border-top: 5px solid var(--color-accent);
		color: rgb(255 255 255 / 0.78);
		font-size: var(--text-sm);
	}

	.site-footer__inner {
		display: grid;
		gap: var(--space-8);
		padding-bottom: var(--space-12);
	}

	.site-footer :global(.brand) {
		color: var(--color-header-text);
	}

	.site-footer :global(.brand__sub),
	.site-footer__tagline,
	.site-footer__availability {
		max-width: 24rem;
		margin-top: var(--space-4);
		margin-bottom: 0;
		color: rgb(255 255 255 / 0.68);
	}

	.site-footer__availability {
		font-size: var(--text-xs);
	}

	.site-footer__heading {
		margin: 0 0 var(--space-3);
		color: var(--color-header-text);
		font-size: var(--text-sm);
		font-weight: 700;
	}

	.site-footer__nav ul {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__nav a {
		color: rgb(255 255 255 / 0.78);
		text-decoration: none;
	}

	.site-footer__nav a:hover {
		color: var(--color-highlight);
		text-decoration: underline;
	}

	.site-footer__bottom {
		padding-block: var(--space-5);
		border-top: 1px solid rgb(255 255 255 / 0.16);
		color: rgb(255 255 255 / 0.62);
		font-size: var(--text-xs);
	}

	.site-footer__bottom p {
		margin: 0;
	}

	@media (min-width: 40rem) {
		.site-footer__inner {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.site-footer__inner {
			grid-template-columns: 1.5fr 0.8fr 0.8fr;
		}
	}
</style>
