---
/**
 * Filter berbasis tautan (bukan state klien) agar tetap crawlable dan
 * berfungsi tanpa JavaScript.
 */
interface Item {
	label: string;
	href: string;
	active?: boolean;
}

interface Props {
	items: Item[];
	label?: string;
}

const { items, label = "Filter produk" } = Astro.props;
---

<nav class="filter-tabs" aria-label={label}>
	<ul class="filter-tabs__list">
		{
			items.map((item) => (
				<li>
					<a
						class:list={["filter-tabs__link", item.active && "filter-tabs__link--active"]}
						href={item.href}
						aria-current={item.active ? "true" : undefined}
					>
						{item.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.filter-tabs__list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.filter-tabs__link {
		display: inline-flex;
		align-items: center;
		min-height: 2.25rem;
		padding: var(--space-1) var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		background: var(--color-surface);
		color: var(--color-muted);
		font-size: var(--text-sm);
		font-weight: 600;
		text-decoration: none;
		transition:
			background-color 120ms ease,
			border-color 120ms ease,
			color 120ms ease;
	}

	.filter-tabs__link:hover {
		border-color: var(--color-accent-light);
		color: var(--color-accent-hover);
	}

	.filter-tabs__link--active,
	.filter-tabs__link[aria-current="true"] {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-accent-contrast);
	}
</style>
