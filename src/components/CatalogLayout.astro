---
import CatalogFilters from "./CatalogFilters.astro";

interface CategoryOption {
	label: string;
	slug: string;
	count?: number | null;
}

interface Props {
	categories: CategoryOption[];
	activeCategory?: string;
	activeFilter?: boolean;
	resultLabel: string;
}

const { categories, activeCategory, activeFilter = false, resultLabel } = Astro.props;
const hasActiveFilter = Boolean(activeCategory) || activeFilter;
---

<div class="catalog-layout">
	<CatalogFilters
		categories={categories}
		activeCategory={activeCategory}
		activeFilter={hasActiveFilter}
	/>

	<div class="catalog-layout__results">
		<div class="catalog-toolbar">
			<p>{resultLabel}</p>
			<span>Urutan: Terbaru</span>
		</div>
		{
			hasActiveFilter && (
				<div class="catalog-chips" aria-label="Filter aktif">
					<slot name="active-filter" />
					<a href="/products">Hapus filter</a>
				</div>
			)
		}
		<slot />
	</div>
</div>

<style>
	.catalog-layout {
		display: grid;
		gap: var(--space-5);
	}

	.catalog-layout__results {
		min-width: 0;
	}

	.catalog-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		margin-bottom: var(--space-4);
		padding: var(--space-3) var(--space-4);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		font-size: var(--text-sm);
	}

	.catalog-toolbar p {
		margin: 0;
		font-weight: 700;
	}

	.catalog-toolbar span {
		color: var(--color-muted);
		white-space: nowrap;
	}

	.catalog-chips {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
		margin-bottom: var(--space-4);
	}

	.catalog-chips :global(.catalog-chip) {
		display: inline-flex;
		min-height: 2rem;
		align-items: center;
		padding: var(--space-1) var(--space-3);
		background: var(--color-accent-soft);
		border: 1px solid var(--color-accent-light);
		border-radius: var(--radius-pill);
		color: var(--color-accent-hover);
		font-size: var(--text-sm);
		font-weight: 700;
	}

	.catalog-chips > a {
		font-size: var(--text-sm);
		font-weight: 650;
	}

	@media (min-width: 64rem) {
		.catalog-layout {
			grid-template-columns: 15.5rem minmax(0, 1fr);
			align-items: start;
			gap: var(--space-6);
		}
	}
</style>
