---
/**
 * Placeholder jujur untuk aset yang belum tersedia (ADR-033).
 * Rasio tetap agar tidak menimbulkan layout shift, dan diberi label DEMO
 * supaya tidak terlihat seperti foto produk sungguhan.
 */
interface Props {
	ratio?: "4:3" | "16:9" | "1:1";
	label?: string;
	hint?: string;
	class?: string;
}

const {
	ratio = "4:3",
	label = "Gambar belum tersedia",
	hint = "DEMO",
	class: className,
} = Astro.props;
---

<div
	class:list={["media-placeholder", `media-placeholder--${ratio.replace(":", "-")}`, className]}
	role="img"
	aria-label={`${label} (${hint})`}
>
	<span class="media-placeholder__label">{label}</span>
	<span class="media-placeholder__hint">{hint}</span>
</div>

<style>
	.media-placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--space-1);
		width: 100%;
		padding: var(--space-4);
		background:
			repeating-linear-gradient(
				135deg,
				var(--color-surface-muted) 0 10px,
				var(--color-surface) 10px 20px
			);
		border: 1px dashed var(--color-border-strong);
		border-radius: var(--radius-md);
		text-align: center;
	}

	.media-placeholder--4-3 {
		aspect-ratio: 4 / 3;
	}

	.media-placeholder--16-9 {
		aspect-ratio: 16 / 9;
	}

	.media-placeholder--1-1 {
		aspect-ratio: 1 / 1;
	}

	.media-placeholder__label {
		color: var(--color-ink-soft);
		font-size: var(--text-xs);
		font-weight: 600;
	}

	.media-placeholder__hint {
		color: var(--color-muted);
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}
</style>
