---
import type { ImageValue } from "emdash";
import { Image } from "emdash/ui";
import CategoryIcon from "./CategoryIcon.astro";

interface Props {
	title: string;
	href: string;
	count?: number | null;
	icon?: ImageValue | null;
}

const { title, href, count, icon = null } = Astro.props;
---

<a class="category-tile" href={href}>
	<span class:list={["category-tile__media", { "category-tile__media--image": icon }]}>
		{
			icon ? (
				<Image image={icon} width={64} height={64} />
			) : (
				<CategoryIcon category={`${title} ${href}`} />
			)
		}
	</span>
	<span class="category-tile__body">
		<strong>{title}</strong>
		{
			typeof count === "number" && (
				<span>{count} produk</span>
			)
		}
	</span>
	<span class="category-tile__arrow" aria-hidden="true">›</span>
</a>

<style>
	.category-tile {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--space-3);
		height: 100%;
		min-height: 5.5rem;
		padding: var(--space-4);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		color: var(--color-ink);
		text-decoration: none;
		transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
	}

	.category-tile:hover {
		border-color: var(--color-accent-light);
		box-shadow: var(--shadow-card-hover);
		color: var(--color-ink);
		transform: translateY(-2px);
	}

	.category-tile:hover .category-tile__media:not(.category-tile__media--image) {
		background: var(--color-accent);
		color: var(--color-accent-contrast);
	}

	.category-tile__media {
		display: grid;
		place-items: center;
		width: 3.5rem;
		height: 3.5rem;
		padding: var(--space-2);
		background: var(--color-accent-soft);
		border-radius: var(--radius-md);
		color: var(--color-accent-hover);
		transition: background-color 160ms ease, color 160ms ease;
	}

	.category-tile__media--image {
		overflow: hidden;
		padding: 0;
		background: var(--color-surface-muted);
	}

	.category-tile__media--image :global(picture),
	.category-tile__media--image :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.category-tile__media--image :global(img) {
		object-fit: cover;
	}

	.category-tile__body {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.1rem;
	}

	.category-tile__body strong {
		display: -webkit-box;
		overflow: hidden;
		font-size: var(--text-sm);
		line-height: 1.35;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.category-tile__body span {
		color: var(--color-muted);
		font-size: var(--text-xs);
	}

	.category-tile__arrow {
		color: var(--color-accent);
		font-size: var(--text-xl);
		font-weight: 700;
	}
</style>
