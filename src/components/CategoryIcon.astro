---
interface Props {
	category: string;
	size?: number;
}

const { category, size = 32 } = Astro.props;
const value = category.toLowerCase();

const type = value.includes("cctv") || value.includes("camera") || value.includes("kamera")
	? "camera"
	: value === "dvr" || value.includes("recorder")
		? "dvr"
		: value === "nvr"
			? "nvr"
			: value.includes("switch")
				? "switch"
				: value.includes("monitor") || value.includes("display")
					? "monitor"
					: value.includes("power") || value.includes("supply") || value.includes("adaptor")
						? "power"
						: value.includes("midspan") || value.includes("poe")
							? "poe"
							: value.includes("aksesori") || value.includes("accessor")
								? "accessory"
								: "generic";
---

<svg
	class="category-icon"
	viewBox="0 0 48 48"
	width={size}
	height={size}
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{type === "camera" && (
		<>
			<path d="M7 18h23l8 7v9H18L7 28z" />
			<circle cx="18" cy="26" r="5" />
			<path d="M38 29h4M31 34l-4 7M22 41h10" />
		</>
	)}
	{type === "dvr" && (
		<>
			<rect x="6" y="14" width="36" height="22" rx="4" />
			<circle cx="13" cy="25" r="2" />
			<path d="M19 25h13M36 22v6M10 40h28" />
		</>
	)}
	{type === "nvr" && (
		<>
			<rect x="6" y="12" width="36" height="24" rx="4" />
			<path d="M12 20h24M12 27h17" />
			<circle cx="36" cy="28" r="2" />
			<path d="M15 40h18" />
		</>
	)}
	{type === "switch" && (
		<>
			<rect x="5" y="15" width="38" height="20" rx="4" />
			<path d="M11 22h4v5h-4zM19 22h4v5h-4zM27 22h4v5h-4zM35 22h3v5h-3z" />
			<path d="M13 31h22" />
		</>
	)}
	{type === "monitor" && (
		<>
			<rect x="6" y="8" width="36" height="27" rx="3" />
			<path d="M20 35v5M28 35v5M15 40h18" />
			<path d="M12 14h24v15H12z" />
		</>
	)}
	{type === "power" && (
		<>
			<rect x="10" y="10" width="28" height="28" rx="6" />
			<path d="M24 6v9M18 17a9 9 0 1 0 12 0" />
		</>
	)}
	{type === "poe" && (
		<>
			<rect x="7" y="14" width="34" height="20" rx="4" />
			<path d="M13 21h9v7h-9zM27 21h8M27 27h8" />
			<path d="m23 8-4 8h6l-3 8 8-11h-6l3-5" />
		</>
	)}
	{type === "accessory" && (
		<>
			<path d="M17 7h14v9H17zM12 16h24v25H12z" />
			<path d="M18 23h12M18 29h12M18 35h7" />
		</>
	)}
	{type === "generic" && (
		<>
			<path d="m24 5 17 9-17 9L7 14z" />
			<path d="m7 14 17 9 17-9v20l-17 9-17-9z" />
			<path d="M24 23v20" />
		</>
	)}
</svg>

<style>
	.category-icon {
		width: 100%;
		height: 100%;
	}
</style>
