---
import { Image } from "emdash/ui";
import type { ImageValue } from "emdash";

interface Props {
	name: string;
	logo?: ImageValue | null;
	href?: string;
}

const { name, logo = null, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class="brand-tile" href={href}>
	{
		logo ? (
			<span class="brand-tile__logo"><Image image={logo} /></span>
		) : (
			<span class="brand-tile__mark" aria-hidden="true">{name.slice(0, 1).toUpperCase()}</span>
		)
	}
	<span class="brand-tile__name">{name}</span>
</Tag>

<style>
	.brand-tile {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-3);
		min-height: 5rem;
		padding: var(--space-4);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		color: var(--color-ink);
		text-align: center;
		text-decoration: none;
	}

	a.brand-tile:hover {
		border-color: var(--color-accent-light);
		box-shadow: var(--shadow-card);
		color: var(--color-ink);
	}

	.brand-tile__logo {
		display: grid;
		place-items: center;
		width: 3.5rem;
		height: 2.75rem;
	}

	.brand-tile__logo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.brand-tile__mark {
		display: grid;
		flex: 0 0 auto;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		background: var(--color-surface-muted);
		border-radius: var(--radius-pill);
		color: var(--color-accent-hover);
		font-weight: 700;
	}

	.brand-tile__name {
		font-size: var(--text-sm);
		font-weight: 700;
		line-height: 1.3;
	}
</style>
