---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<a class="brand" href="/" aria-label={`${title} — beranda`}>
	<img
		class="brand__image"
		src="/LOGO%20ASATECH.png"
		alt={title}
		width="2000"
		height="800"
	/>
</a>

<style>
	.brand {
		display: inline-flex;
		align-items: center;
		flex: none;
		text-decoration: none;
	}

	.brand__image {
		display: block;
		width: auto;
		height: 2.75rem;
		border-radius: var(--radius-sm);
	}

	@media (min-width: 48rem) {
		.brand__image {
			height: 3rem;
		}
	}
</style>
