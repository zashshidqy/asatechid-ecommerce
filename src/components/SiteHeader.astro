---
import { getMenuWithCacheHint } from "emdash";
import LiveSearch from "emdash/ui/search";
import Logo from "./Logo.astro";
import type { MediaReference } from "../utils/site-identity";

interface Props {
	siteTitle: string;
	siteTagline?: string;
	siteLogo?: MediaReference | null;
	searchCollections?: string[];
}

const {
	siteTitle,
	siteTagline = "",
	siteLogo = null,
	searchCollections = ["products", "posts", "pages"],
} = Astro.props;

const searchRouteMap = {
	products: "/products/:slug",
	posts: "/posts/:slug",
	pages: "/:slug",
};

const { data: menu, cacheHint } = await getMenuWithCacheHint("primary");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const items = menu?.items ?? [];
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

function isActive(url: string): boolean {
	if (!url.startsWith("/")) return false;
	const normalized = url.replace(/\/+$/, "") || "/";
	return normalized === "/"
		? path === "/"
		: path === normalized || path.startsWith(`${normalized}/`);
}
---

<header class="site-header">
	<div class="container site-header__main">
		<Logo title={siteTitle} logo={siteLogo} />

		<div class="site-search" role="search" aria-label="Pencarian situs">
			<LiveSearch
				placeholder="Cari produk, merek, atau artikel..."
				collections={searchCollections}
				routeMap={searchRouteMap}
			>
				<span slot="loading">Mencari…</span>
				<span slot="no-results">Tidak ada hasil.</span>
			</LiveSearch>
		</div>

		<details class="nav-disclosure">
			<summary class="btn btn--secondary btn--sm">Menu</summary>
			<nav class="nav-disclosure__panel" aria-label="Navigasi seluler">
				<div class="nav-disclosure__search">
					<LiveSearch
						placeholder="Cari produk, merek, atau artikel..."
						collections={searchCollections}
						routeMap={searchRouteMap}
					>
						<span slot="loading">Mencari…</span>
						<span slot="no-results">Tidak ada hasil.</span>
					</LiveSearch>
				</div>
				<a href="/products" aria-current={isActive("/products") ? "page" : undefined}>Katalog produk</a>
				{
					items.filter((item) => item.url !== "/products").map((item) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							aria-current={isActive(item.url) ? "page" : undefined}
						>
							{item.label}
						</a>
					))
				}
			</nav>
		</details>
	</div>

	<div class="site-header__nav-row">
		<div class="container site-header__nav-inner">
			<a class="catalog-link" href="/products" aria-current={isActive("/products") ? "page" : undefined}>
				<span aria-hidden="true">☰</span> Semua produk
			</a>
			<nav class="site-nav" aria-label="Navigasi utama">
				{
					items.filter((item) => item.url !== "/products").map((item) => (
						<a
							class="site-nav__link"
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							aria-current={isActive(item.url) ? "page" : undefined}
						>
							{item.label}
						</a>
					))
				}
			</nav>
			{siteTagline && <p class="site-header__tagline">{siteTagline}</p>}
		</div>
	</div>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 10;
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
	}

	.site-header__main {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		min-height: var(--header-height);
	}

	.site-search {
		display: none;
		flex: 1;
		max-width: 42rem;
		margin-left: auto;
	}

	.nav-disclosure {
		position: relative;
		margin-left: auto;
	}

	.nav-disclosure > summary {
		list-style: none;
		user-select: none;
	}

	.nav-disclosure > summary::-webkit-details-marker {
		display: none;
	}

	.nav-disclosure__panel {
		position: absolute;
		top: calc(100% + var(--space-2));
		right: 0;
		display: flex;
		flex-direction: column;
		width: min(22rem, calc(100vw - 2 * var(--container-pad)));
		padding: var(--space-2);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-md);
	}

	.nav-disclosure__search {
		margin-bottom: var(--space-2);
		padding: var(--space-2) var(--space-2) var(--space-3);
		border-bottom: 1px solid var(--color-border);
	}

	.nav-disclosure__panel a {
		padding: var(--space-3);
		border-radius: var(--radius-sm);
		color: var(--color-ink-soft);
		font-size: var(--text-sm);
		font-weight: 600;
		text-decoration: none;
	}

	.nav-disclosure__panel a:hover {
		background: var(--color-surface-muted);
		color: var(--color-ink);
	}

	.nav-disclosure__panel a[aria-current="page"] {
		color: var(--color-accent-hover);
	}

	.site-header__nav-row {
		display: none;
		border-top: 1px solid var(--color-border);
	}

	.site-header__nav-inner {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		min-height: 3rem;
	}

	.catalog-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		align-self: stretch;
		padding-inline: var(--space-4);
		background: var(--color-accent);
		color: var(--color-accent-contrast);
		font-size: var(--text-sm);
		font-weight: 700;
		text-decoration: none;
	}

	.catalog-link:hover,
	.catalog-link[aria-current="page"] {
		background: var(--color-accent-hover);
		color: var(--color-accent-contrast);
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: var(--space-6);
	}

	.site-nav__link {
		padding-block: var(--space-2);
		border-bottom: 2px solid transparent;
		color: var(--color-ink-soft);
		font-size: var(--text-sm);
		font-weight: 600;
		text-decoration: none;
	}

	.site-nav__link:hover,
	.site-nav__link[aria-current="page"] {
		color: var(--color-accent-hover);
		border-bottom-color: var(--color-accent);
	}

	.site-header__tagline {
		overflow: hidden;
		margin: 0 0 0 auto;
		max-width: 24rem;
		color: var(--color-muted);
		font-size: var(--text-xs);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	@media (min-width: 48rem) {
		.site-search {
			display: block;
		}

		.nav-disclosure {
			display: none;
		}

		.site-header__nav-row {
			display: block;
		}
	}
</style>
