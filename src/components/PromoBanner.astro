---
import MediaPlaceholder from "./MediaPlaceholder.astro";

/**
 * Banner promo. Isi promo berasal dari pemanggil (CMS/seed) — komponen ini
 * tidak pernah mengarang judul, harga, atau angka diskon. Bila `href` kosong,
 * CTA dirender nonaktif dengan label jelas (ADR-033).
 */
interface Props {
	kicker?: string;
	title: string;
	subtitle?: string;
	meta?: string;
	href?: string;
	cta?: string;
	tone?: "gradient" | "soft";
	placeholderLabel?: string;
}

const {
	kicker = "Konten promo",
	title,
	subtitle,
	meta,
	href,
	cta = "Lihat promo",
	tone = "gradient",
	placeholderLabel = "Slot banner promo",
} = Astro.props;
---

<aside class:list={["promo", `promo--${tone}`]} aria-label="Banner promo">
	<div class="promo__body">
		<p class="promo__kicker">{kicker}</p>
		<p class="promo__title">{title}</p>
		{subtitle && <p class="promo__subtitle">{subtitle}</p>}
		{meta && <p class="promo__meta">{meta}</p>}
		{
			href ? (
				<a class="promo__cta" href={href}>
					{cta} <span aria-hidden="true">›</span>
				</a>
			) : (
				<span class="promo__cta promo__cta--disabled" aria-disabled="true">
					{cta} belum tersedia
				</span>
			)
		}
	</div>
	<div class="promo__media">
		<MediaPlaceholder ratio="16:9" label={placeholderLabel} hint="DEMO" />
	</div>
</aside>

<style>
	.promo {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-4);
		height: 100%;
		padding: var(--space-6);
		border-radius: var(--radius-xl);
		color: var(--color-ink);
	}

	.promo--gradient {
		background: var(--gradient-promo-soft);
	}

	.promo--soft {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-card);
	}

	.promo__kicker {
		margin: 0 0 var(--space-2);
		color: var(--color-accent-hover);
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.promo__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 700;
		line-height: var(--leading-snug);
	}

	.promo__subtitle {
		margin: var(--space-2) 0 0;
		color: var(--color-ink-soft);
		font-size: var(--text-sm);
	}

	.promo__meta {
		margin: var(--space-2) 0 0;
		color: var(--color-muted);
		font-size: var(--text-xs);
	}

	.promo__cta {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		align-self: flex-start;
		margin-top: var(--space-4);
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-md);
		background: var(--color-accent);
		color: var(--color-accent-contrast);
		font-size: var(--text-sm);
		font-weight: 650;
		text-decoration: none;
	}

	.promo__cta:hover {
		background: var(--color-accent-hover);
		color: var(--color-accent-contrast);
	}

	.promo__cta--disabled {
		background: var(--color-surface);
		border: 1px dashed var(--color-border-strong);
		color: var(--color-muted);
		cursor: not-allowed;
	}

	.promo__media {
		margin-top: auto;
		max-width: 24rem;
	}
</style>
