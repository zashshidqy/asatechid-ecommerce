---
import { Image } from "emdash/ui";
import Card from "./Card.astro";
import Badge from "./Badge.astro";
import MediaPlaceholder from "./MediaPlaceholder.astro";
import {
	availabilityLabel,
	formatProductPrice,
	getProductCategories,
	type ProductCardEntry,
} from "../utils/product";

interface Props {
	product: ProductCardEntry;
	headingLevel?: "h2" | "h3";
	badge?: { label: string; tone?: "accent" | "highlight" | "soft" };
	showExcerpt?: boolean;
}

const {
	product,
	headingLevel = "h2",
	badge,
	showExcerpt = false,
} = Astro.props;
const Heading = headingLevel;
const image = product.data.featured_image;
const categories = getProductCategories(product.data.terms);
const price = formatProductPrice(product.data.price, product.data.currency);
const availability = availabilityLabel(product.data.availability);
const isOutOfStock = availability === "Tidak tersedia";
---

<Card class="product-card">
	<a class="product-card__media-link" href={`/products/${product.id}`} aria-label={`Lihat ${product.data.title}`}>
		<div class="card__media product-card__media" {...(product.edit?.featured_image ?? {})}>
			{
				image ? (
					<>
						<Image image={image} />
						<div class="product-card__image-fallback" aria-hidden="true">
							<span>Gambar produk tidak dapat dimuat</span>
						</div>
					</>
				) : (
					<MediaPlaceholder
						ratio="1:1"
						label="Gambar produk"
						class="product-card__placeholder"
					/>
				)
			}
			<div class="product-card__badges">
				{badge && <Badge tone={badge.tone ?? "accent"}>{badge.label}</Badge>}
				{isOutOfStock && <Badge tone="muted">Tidak tersedia</Badge>}
			</div>
		</div>
	</a>

	<div class="card__body product-card__body">
		{
			categories.length > 0 && (
				<a
					class="product-card__category"
					href={`/products/category/${categories[0].slug}`}
				>
					{categories[0].label}
				</a>
			)
		}

		<Heading class="card__title product-card__title">
			<a href={`/products/${product.id}`}>{product.data.title}</a>
		</Heading>

		{
			showExcerpt && product.data.excerpt && (
				<p class="card__excerpt product-card__excerpt" {...product.edit?.excerpt}>
					{product.data.excerpt}
				</p>
			)
		}

		<div class="product-card__commerce">
			{
				price ? (
					<span class="product-card__prices">
						<span class="product-card__price">{price}</span>
					</span>
				) : (
					<span class="product-card__price product-card__price--missing">
						Harga belum tersedia
					</span>
				)
			}

			{availability && !isOutOfStock && <span class="product-card__availability">{availability}</span>}
		</div>
	</div>
</Card>

<style>
	.product-card__media-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.product-card__media {
		position: relative;
		aspect-ratio: 1;
		background: var(--color-surface);
	}

	.product-card__media :global(img) {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 100%;
		padding: var(--space-3);
		background: var(--color-surface);
		object-fit: contain;
	}

	.product-card__image-fallback {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		padding: var(--space-4);
		background: var(--color-surface-muted);
		color: var(--color-muted);
		font-size: var(--text-xs);
		font-weight: 600;
		text-align: center;
	}

	.product-card__placeholder {
		height: 100%;
		border: 0;
		border-radius: 0;
	}

	.product-card__badges {
		position: absolute;
		top: var(--space-3);
		left: var(--space-3);
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		max-width: calc(100% - 2 * var(--space-3));
	}

	.product-card__body {
		gap: var(--space-2);
		padding: var(--space-4);
	}

	.product-card__category {
		overflow: hidden;
		color: var(--color-muted);
		font-size: var(--text-xs);
		font-weight: 600;
		text-decoration: none;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.product-card__category:hover {
		color: var(--color-accent-hover);
		text-decoration: underline;
	}

	.product-card__title {
		display: -webkit-box;
		overflow: hidden;
		min-height: 2.7em;
		font-size: var(--text-sm);
		font-weight: 600;
		line-height: 1.35;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.product-card__excerpt {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.product-card__commerce {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin-top: auto;
		padding-top: var(--space-2);
	}

	.product-card__prices {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2);
	}

	.product-card__price {
		color: var(--color-ink);
		font-size: var(--text-lg);
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		line-height: 1.25;
	}

	.product-card__price--missing {
		color: var(--color-muted);
		font-size: var(--text-sm);
		font-weight: 600;
	}


	.product-card__availability {
		color: var(--color-success);
		font-size: var(--text-xs);
		font-weight: 700;
	}
</style>
