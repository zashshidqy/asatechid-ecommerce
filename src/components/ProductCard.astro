---
import { Image } from "emdash/ui";
import Card from "./Card.astro";
import Badge from "./Badge.astro";
import {
	availabilityLabel,
	formatProductPrice,
	getProductCategories,
	type ProductCardEntry,
} from "../utils/product";

interface Props {
	product: ProductCardEntry;
	headingLevel?: "h2" | "h3";
}

const { product, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const image = product.data.featured_image;
const categories = getProductCategories(product.data.terms);
const price = formatProductPrice(product.data.price, product.data.currency);
const availability = availabilityLabel(product.data.availability);
---

<Card>
	<div class="card__media" {...(product.edit?.featured_image ?? {})}>
		{
			image ? (
				<Image image={image} />
			) : (
				<div class="product-card__placeholder">
					<span class="product-card__placeholder-label">
						Gambar belum tersedia
					</span>
				</div>
			)
		}
	</div>
	<div class="card__body">
		{
			categories.length > 0 && (
				<div class="product-card__categories">
					{categories.map((category) => (
						<a
							class="badge badge--muted"
							href={`/products/category/${category.slug}`}
						>
							{category.label}
						</a>
					))}
				</div>
			)
		}

		<Heading class="card__title">
			<a href={`/products/${product.id}`}>{product.data.title}</a>
		</Heading>

		{
			product.data.excerpt && (
				<p class="card__excerpt" {...product.edit?.excerpt}>
					{product.data.excerpt}
				</p>
			)
		}

		{
			(price || availability) && (
				<div class="product-card__meta">
					{price && <span class="product-card__price">{price}</span>}
					{availability && (
						<Badge
							tone={
								availability === "Tersedia"
									? "accent"
									: availability === "Pre-order"
										? "default"
										: "muted"
							}
						>
							{availability}
						</Badge>
					)}
				</div>
			)
		}
	</div>
</Card>

<style>
	.product-card__placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		padding: var(--space-4);
		background: var(--color-surface-muted);
	}

	.product-card__placeholder-label {
		color: var(--color-muted);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.product-card__categories {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.product-card__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-3);
		margin-top: auto;
		padding-top: var(--space-2);
	}

	.product-card__price {
		color: var(--color-ink);
		font-size: var(--text-base);
		font-weight: 650;
	}
</style>
