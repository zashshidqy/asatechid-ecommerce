---
import {
	getEmDashCollection,
	getTaxonomyTermsWithCacheHint,
} from "emdash";
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EmptyState from "../../components/EmptyState.astro";
import PostGrid from "../../components/PostGrid.astro";
import TaxonomyNav from "../../components/TaxonomyNav.astro";
import { POST_CATEGORY_TAXONOMY } from "../../utils/post";

const cursor = Astro.url.searchParams.get("cursor") || undefined;

const {
	entries: posts,
	cacheHint,
	nextCursor,
	error,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 12,
	cursor,
});

if (error) {
	console.error("Failed to load posts:", error);
	return new Response("Tidak dapat memuat artikel.", { status: 500 });
}

const termsResult = await getTaxonomyTermsWithCacheHint(POST_CATEGORY_TAXONOMY, {
	includeCounts: true,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(termsResult.cacheHint);
}
---

<Base
	title="Artikel"
	description="Panduan, catatan, dan penjelasan yang membantu memahami produk serta teknologi di baliknya."
>
	<Container>
		<Breadcrumbs items={[{ label: "Beranda", href: "/" }, { label: "Artikel" }]} />

		<header class="page-head">
			<p class="page-head__eyebrow">Editorial</p>
			<h1>Artikel</h1>
			<p class="page-head__lead">
				Panduan, catatan, dan penjelasan yang membantu memahami produk serta
				teknologi di baliknya.
			</p>
		</header>

		<TaxonomyNav
			terms={termsResult.data}
			hrefBase="/category"
			label="Kategori artikel"
			showCounts
		/>

		{
			posts.length === 0 ? (
				<EmptyState
					title="Belum ada artikel"
					description="Artikel yang dipublikasikan melalui CMS akan tampil di halaman ini."
				/>
			) : (
				<PostGrid posts={posts} />
			)
		}

		{(cursor || nextCursor) && (
			<nav class="pagination" aria-label="Navigasi halaman artikel">
				{cursor && (
					<a class="btn btn--secondary btn--sm" href="/posts">
						Halaman pertama
					</a>
				)}
				{nextCursor && (
					<a
						class="btn btn--secondary btn--sm"
						href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}
					>
						Halaman berikutnya
					</a>
				)}
			</nav>
		)}
	</Container>
</Base>

<style>
	.pagination {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-10);
	}
</style>
