---
import {
	decodeSlug,
	getEmDashEntry,
	getEmDashReferences,
	getTaxonomyTermsWithCacheHint,
} from "emdash";
import Base from "../../../layouts/Base.astro";
import Container from "../../../components/Container.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import EmptyState from "../../../components/EmptyState.astro";
import ProductGrid from "../../../components/ProductGrid.astro";
import CatalogLayout from "../../../components/CatalogLayout.astro";

const id = decodeSlug(Astro.params.id);
if (!id) {
	return Astro.rewrite("/404");
}

const brandResult = await getEmDashEntry("brands", id);
if (brandResult.error) {
	console.error("Failed to load brand:", brandResult.error);
	return new Response("Tidak dapat memuat merek.", { status: 500 });
}

const brand = brandResult.entry;
if (!brand) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const productsResult = await getEmDashReferences("brands", brand.id, "products", {
	limit: 20,
	cursor,
});
if (productsResult.error) {
	console.error("Failed to load products for brand:", productsResult.error);
	return new Response("Tidak dapat memuat produk.", { status: 500 });
}

const termsResult = await getTaxonomyTermsWithCacheHint("product_category", {
	includeCounts: true,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(brandResult.cacheHint);
	Astro.cache.set(termsResult.cacheHint);
	if (productsResult.cacheHint) Astro.cache.set(productsResult.cacheHint);
}

const products = productsResult.entries;
const nextCursor = productsResult.nextCursor;
const resultLabel = `${products.length} produk${nextCursor ? " pada halaman ini" : ""}`;
const brandPath = `/products/brand/${encodeURIComponent(brand.id)}`;
---

<Base
	title={`${brand.data.name} — Produk`}
	description={`Produk dengan merek ${brand.data.name}.`}
>
	<Container>
		<Breadcrumbs
			items={[
				{ label: "Beranda", href: "/" },
				{ label: "Produk", href: "/products" },
				{ label: brand.data.name },
			]}
		/>

		<header class="page-head catalog-head">
			<p class="page-head__eyebrow">Merek produk</p>
			<h1>{brand.data.name}</h1>
			<p class="page-head__lead">Jelajahi produk dengan merek {brand.data.name}.</p>
		</header>

		<CatalogLayout
			categories={termsResult.data}
			activeFilter={true}
			resultLabel={resultLabel}
		>
			<span slot="active-filter" class="catalog-chip">Merek: {brand.data.name}</span>
			{
				products.length === 0 ? (
					<EmptyState
						title="Produk tidak ditemukan"
						description={`Belum ada produk yang dipublikasikan dengan merek ${brand.data.name}.`}
					>
						<a class="btn btn--secondary btn--sm" href="/products">Lihat semua produk</a>
					</EmptyState>
				) : (
					<ProductGrid products={products} />
				)
			}

			<nav class="pagination" aria-label="Navigasi halaman merek">
				{cursor && (
					<a class="btn btn--secondary btn--sm" href={brandPath}>
						Halaman pertama
					</a>
				)}
				{nextCursor && (
					<a
						class="btn btn--secondary btn--sm"
						href={`${brandPath}?cursor=${encodeURIComponent(nextCursor)}`}
					>
						Halaman berikutnya
					</a>
				)}
			</nav>
		</CatalogLayout>
	</Container>
</Base>

<style>
	.catalog-head {
		margin-bottom: var(--space-8);
	}

	.pagination {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}
</style>
