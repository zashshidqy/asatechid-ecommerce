---
import {
	decodeSlug,
	getEmDashCollection,
	getTaxonomyTermsWithCacheHint,
} from "emdash";
import Base from "../../../layouts/Base.astro";
import Container from "../../../components/Container.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import EmptyState from "../../../components/EmptyState.astro";
import ProductGrid from "../../../components/ProductGrid.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("product_category", {
	includeCounts: true,
});
const term = slug
	? termsResult.data.find((item) => item.slug === slug)
	: undefined;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;

const { entries: products, cacheHint, nextCursor, error } =
	await getEmDashCollection("products", {
		where: { product_category: term.slug },
		orderBy: { published_at: "desc" },
		limit: 12,
		cursor,
	});

if (error) {
	console.error("Failed to load products for category:", error);
	return new Response("Tidak dapat memuat produk.", { status: 500 });
}

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base
	title={`${term.label} — Produk`}
	description={`Produk dalam kategori ${term.label}.`}
>
	<Container>
		<Breadcrumbs
			items={[
				{ label: "Beranda", href: "/" },
				{ label: "Produk", href: "/products" },
				{ label: term.label },
			]}
		/>

		<header class="page-head">
			<p class="page-head__eyebrow">Kategori Produk</p>
			<h1>{term.label}</h1>
			<p class="page-head__lead">Produk dalam kategori {term.label}.</p>
			<p>
				<a class="btn btn--secondary btn--sm" href="/products">
					Lihat semua produk
				</a>
			</p>
		</header>

		{
			products.length === 0 ? (
				<EmptyState
					title="Belum ada produk"
					description={`Belum ada produk yang dipublikasikan dalam kategori ${term.label}.`}
				/>
			) : (
				<ProductGrid products={products} />
			)
		}

		<nav class="pagination" aria-label="Navigasi halaman kategori">
			{cursor && (
				<a
					class="btn btn--secondary btn--sm"
					href={`/products/category/${term.slug}`}
				>
					Halaman pertama
				</a>
			)}
			{nextCursor && (
				<a
					class="btn btn--secondary btn--sm"
					href={`/products/category/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}
				>
					Halaman berikutnya
				</a>
			)}
		</nav>
	</Container>
</Base>

<style>
	.pagination {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-10);
	}
</style>
