---
import {
	getEmDashCollection,
	getTaxonomyTermsWithCacheHint,
} from "emdash";
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EmptyState from "../../components/EmptyState.astro";
import ProductGrid from "../../components/ProductGrid.astro";
import CategoryTile from "../../components/CategoryTile.astro";
import CatalogLayout from "../../components/CatalogLayout.astro";
import {
	mapCategoryIcons,
	PRODUCT_CATEGORY_PROFILE_COLLECTION,
} from "../../utils/category-profile";

const cursor = Astro.url.searchParams.get("cursor") || undefined;

const { entries: products, cacheHint, nextCursor, error } =
	await getEmDashCollection("products", {
		orderBy: { published_at: "desc" },
		limit: 20,
		cursor,
	});

if (error) {
	console.error("Failed to load products:", error);
	return new Response("Tidak dapat memuat produk.", { status: 500 });
}

const termsResult = await getTaxonomyTermsWithCacheHint("product_category", {
	includeCounts: true,
});

const categoryProfilesResult = await getEmDashCollection(
	PRODUCT_CATEGORY_PROFILE_COLLECTION,
	{ limit: 100 },
);
if (categoryProfilesResult.error) {
	console.error("Failed to load category icons:", categoryProfilesResult.error);
	return new Response("Tidak dapat memuat kategori produk.", { status: 500 });
}
const categoryIcons = mapCategoryIcons(categoryProfilesResult.entries);

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(categoryProfilesResult.cacheHint);
}

const resultLabel = `${products.length} produk${nextCursor ? " pada halaman ini" : ""}`;
---

<Base title="Produk" description="Katalog produk ASATECHID Commerce.">
	<Container>
		<Breadcrumbs
			items={[{ label: "Beranda", href: "/" }, { label: "Produk" }]}
		/>

		<header class="page-head catalog-head">
			<p class="page-head__eyebrow">Katalog</p>
			<h1>Semua produk</h1>
			<p class="page-head__lead">
				Temukan produk berdasarkan kategori. Harga dan ketersediaan hanya
				ditampilkan jika datanya sudah diverifikasi.
			</p>
		</header>

		{
			termsResult.data.length > 0 && !cursor && (
				<section class="catalog-categories" aria-labelledby="catalog-categories-title">
					<div class="catalog-section-head">
						<h2 id="catalog-categories-title">Kategori populer</h2>
						<span>{termsResult.data.length} kategori</span>
					</div>
					<ul>
						{termsResult.data.slice(0, 6).map((term) => (
							<li>
								<CategoryTile
									title={term.label}
									count={term.count}
									icon={categoryIcons.get(term.slug.toLowerCase())}
									href={`/products/category/${term.slug}`}
								/>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<section aria-labelledby="catalog-results-title">
			<h2 class="sr-only" id="catalog-results-title">Daftar produk</h2>
			<CatalogLayout categories={termsResult.data} resultLabel={resultLabel}>
				{
					products.length === 0 ? (
						<EmptyState
							title="Belum ada produk"
							description="Produk yang dipublikasikan melalui CMS akan tampil di halaman ini."
						/>
					) : (
						<ProductGrid products={products} />
					)
				}

				<nav class="pagination" aria-label="Navigasi halaman produk">
					{cursor && (
						<a class="btn btn--secondary btn--sm" href="/products">
							Halaman pertama
						</a>
					)}
					{nextCursor && (
						<a
							class="btn btn--secondary btn--sm"
							href={`/products?cursor=${encodeURIComponent(nextCursor)}`}
						>
							Halaman berikutnya
						</a>
					)}
				</nav>
			</CatalogLayout>
		</section>
	</Container>
</Base>

<style>
	.catalog-head {
		margin-bottom: var(--space-8);
	}

	.catalog-categories {
		margin-bottom: var(--space-10);
		padding: var(--space-5);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.catalog-section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-3);
		margin-bottom: var(--space-4);
	}

	.catalog-section-head h2 {
		margin: 0;
		font-size: var(--text-xl);
	}

	.catalog-section-head span {
		color: var(--color-muted);
		font-size: var(--text-sm);
	}

	.catalog-categories ul {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.catalog-categories li {
		display: flex;
	}

	.catalog-categories li > :global(*) {
		flex: 1;
	}

	.pagination {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}

	@media (min-width: 40rem) {
		.catalog-categories ul {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.catalog-categories {
			padding: var(--space-6);
		}

		.catalog-categories ul {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}
	}
</style>
