---
import { getEmDashCollection, getSiteSettings, getTaxonomyTermsWithCacheHint } from "emdash";
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import EmptyState from "../components/EmptyState.astro";
import BrandTile from "../components/BrandTile.astro";
import CategoryTile from "../components/CategoryTile.astro";
import ProductGrid from "../components/ProductGrid.astro";
import PostGrid from "../components/PostGrid.astro";
import SectionHead from "../components/SectionHead.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { PRODUCT_CATEGORY_TAXONOMY } from "../utils/product";
import {
	mapCategoryIcons,
	PRODUCT_CATEGORY_PROFILE_COLLECTION,
} from "../utils/category-profile";

const postsResult = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 3,
});
if (postsResult.error) {
	console.error("Failed to load homepage posts:", postsResult.error);
	return new Response("Tidak dapat memuat beranda.", { status: 500 });
}
if (Astro.cache.enabled) Astro.cache.set(postsResult.cacheHint);
const posts = postsResult.entries;

const productsResult = await getEmDashCollection("products", {
	orderBy: { published_at: "desc" },
	limit: 20,
});
if (productsResult.error) {
	console.error("Failed to load homepage products:", productsResult.error);
	return new Response("Tidak dapat memuat beranda.", { status: 500 });
}
if (Astro.cache.enabled) Astro.cache.set(productsResult.cacheHint);
const allProducts = productsResult.entries;
const featuredProducts = allProducts
	.filter((product) => product.data.featured === true)
	.slice(0, 5);
const newestProducts = allProducts.slice(0, 5);
const newestIds = new Set(newestProducts.map((product) => product.id));
const recommendedProducts = featuredProducts.filter(
	(product) => !newestIds.has(product.id),
);
const shownProductIds = new Set([
	...newestProducts.map((product) => product.id),
	...recommendedProducts.map((product) => product.id),
]);
const remainingProducts = allProducts
	.filter((product) => !shownProductIds.has(product.id))
	.slice(0, 10);

const productCategories = await getTaxonomyTermsWithCacheHint(
	PRODUCT_CATEGORY_TAXONOMY,
	{ includeCounts: true },
);
if (productCategories.error) {
	console.error("Failed to load homepage product categories:", productCategories.error);
	return new Response("Tidak dapat memuat beranda.", { status: 500 });
}
if (Astro.cache.enabled) Astro.cache.set(productCategories.cacheHint);
const categories = productCategories.data;

const categoryProfilesResult = await getEmDashCollection(
	PRODUCT_CATEGORY_PROFILE_COLLECTION,
	{ limit: 100 },
);
if (categoryProfilesResult.error) {
	console.error("Failed to load category icons:", categoryProfilesResult.error);
	return new Response("Tidak dapat memuat beranda.", { status: 500 });
}
if (Astro.cache.enabled) Astro.cache.set(categoryProfilesResult.cacheHint);
const categoryIcons = mapCategoryIcons(categoryProfilesResult.entries);

const brandsResult = await getEmDashCollection("brands", {
	orderBy: { published_at: "desc" },
	limit: 10,
});
if (brandsResult.error) {
	console.error("Failed to load homepage brands:", brandsResult.error);
	return new Response("Tidak dapat memuat beranda.", { status: 500 });
}
if (Astro.cache.enabled) Astro.cache.set(brandsResult.cacheHint);
const brands = brandsResult.entries;

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	await getSiteSettings(),
);
---

<Base title={siteTitle} description={siteTagline} mainClass="site-main--flush">
	<section class="catalog-intro" aria-labelledby="catalog-intro-title">
		<Container>
			<div class="catalog-intro__inner">
				<div class="catalog-intro__copy">
					<p class="eyebrow">Pusat Peralatan & Teknologi</p>
					<h1 id="catalog-intro-title">Solusi produk teknik untuk kebutuhan profesional</h1>
					<p>
						Temukan produk berdasarkan kategori dan kebutuhan. Informasi harga serta ketersediaan hanya ditampilkan setelah diverifikasi.
					</p>
					<div class="catalog-intro__actions">
						<a class="btn btn--primary" href="/products">Jelajahi katalog</a>
						<a class="btn btn--hero-secondary" href="/posts">Baca panduan</a>
					</div>
				</div>
				<div class="catalog-intro__visual" aria-hidden="true">
					<span class="catalog-intro__visual-mark">A</span>
					<span>ASATECHID</span>
					<small>TECHNICAL COMMERCE</small>
				</div>
			</div>
		</Container>
	</section>

	{
		brands.length > 0 && (
			<section class="section" aria-labelledby="brands-title">
				<Container>
					<SectionHead
						title="Merek"
						lead="Merek yang tersedia dalam katalog saat ini."
						id="brands-title"
					/>
					<ul class="brand-grid">
						{brands.map((brand) => (
							<li>
								<BrandTile
									name={brand.data.name}
									logo={brand.data.logo}
									href={`/products/brand/${encodeURIComponent(brand.id)}`}
								/>
							</li>
						))}
					</ul>
				</Container>
			</section>
		)
	}

	{
		categories.length > 0 && (
			<section class="section" aria-labelledby="categories-title">
				<Container>
					<SectionHead
						title="Kategori pilihan"
						lead="Masuk ke katalog melalui kelompok produk."
						id="categories-title"
						href="/products"
						linkLabel="Semua kategori"
					/>
					<ul class="category-grid">
						{categories.slice(0, 8).map((category) => (
							<li>
								<CategoryTile
									title={category.label}
									count={category.count}
									icon={categoryIcons.get(category.slug.toLowerCase())}
									href={`/products/category/${category.slug}`}
								/>
							</li>
						))}
					</ul>
				</Container>
			</section>
		)
	}

	<section class="section" aria-labelledby="new-products-title">
		<Container>
			<SectionHead
				title="Produk terbaru"
				lead="Produk terbaru yang dipublikasikan ke katalog."
				id="new-products-title"
				href="/products"
				linkLabel="Lihat semua"
			/>
			{
				newestProducts.length > 0 ? (
					<ProductGrid products={newestProducts} headingLevel="h3" />
				) : (
					<EmptyState
						title="Katalog masih kosong"
						description="Produk akan muncul setelah dipublikasikan melalui CMS."
					/>
				)
			}
		</Container>
	</section>

	{
		recommendedProducts.length > 0 && (
			<section class="section section--subtle" aria-labelledby="recommended-title">
				<Container>
					<SectionHead
						title="Produk rekomendasi"
						lead="Produk yang ditandai sebagai pilihan oleh pengelola katalog."
						id="recommended-title"
						href="/products"
						linkLabel="Lihat katalog"
					/>
					<ProductGrid products={recommendedProducts} headingLevel="h3" />
				</Container>
			</section>
		)
	}

	<section class="section" aria-labelledby="all-products-title">
		<Container>
			<SectionHead
				title="Semua produk"
				lead="Ringkasan produk yang tersedia saat ini. Gunakan halaman katalog untuk navigasi lengkap."
				id="all-products-title"
				href="/products"
				linkLabel="Buka katalog"
			/>
			{
				remainingProducts.length > 0 ? (
					<ProductGrid products={remainingProducts} headingLevel="h3" />
				) : allProducts.length === 0 ? (
					<EmptyState
						title="Belum ada produk"
						description="Produk yang dipublikasikan melalui CMS akan tampil di sini."
					/>
				) : (
					<EmptyState
						title="Semua produk sudah ditampilkan"
						description="Buka katalog untuk melihat navigasi produk lengkap."
					/>
				)
			}
		</Container>
	</section>

	<section class="section" aria-labelledby="latest-posts-title">
		<Container>
			<SectionHead
				title="Artikel terbaru"
				lead="Panduan dan catatan untuk membantu memahami pilihan produk."
				id="latest-posts-title"
				href="/posts"
				linkLabel="Lihat semua artikel"
			/>
			{
				posts.length > 0 ? (
					<PostGrid posts={posts} headingLevel="h3" />
				) : (
					<EmptyState
						title="Belum ada artikel"
						description="Artikel akan muncul setelah dipublikasikan melalui CMS."
					/>
				)
			}
		</Container>
	</section>
</Base>

<style>
	.catalog-intro {
		position: relative;
		overflow: hidden;
		padding-block: clamp(3rem, 6vw, 5.5rem);
		background: var(--color-header);
		border-bottom: 5px solid var(--color-accent);
		color: var(--color-header-text);
	}

	.catalog-intro::before,
	.catalog-intro::after {
		position: absolute;
		border-radius: 50%;
		content: "";
		pointer-events: none;
	}

	.catalog-intro::before {
		top: -12rem;
		left: 42%;
		width: 24rem;
		height: 24rem;
		background: var(--color-accent);
		opacity: 0.08;
	}

	.catalog-intro::after {
		right: -8rem;
		bottom: -14rem;
		width: 30rem;
		height: 30rem;
		background: var(--color-header-hover);
		opacity: 0.75;
	}

	.catalog-intro__inner {
		position: relative;
		z-index: 1;
		display: grid;
		align-items: center;
		gap: var(--space-8);
	}

	.catalog-intro__copy {
		max-width: 46rem;
	}

	.catalog-intro .eyebrow {
		color: var(--color-highlight);
	}

	.catalog-intro h1 {
		max-width: 46rem;
		margin-top: var(--space-3);
		margin-bottom: var(--space-5);
		font-size: clamp(2.25rem, 5vw, 4.25rem);
		font-weight: 800;
		letter-spacing: -0.035em;
	}

	.catalog-intro p:not(.eyebrow) {
		max-width: 40rem;
		margin: 0;
		color: rgb(255 255 255 / 0.78);
		font-size: var(--text-lg);
	}

	.catalog-intro__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	.btn--hero-secondary {
		background: transparent;
		border-color: rgb(255 255 255 / 0.48);
		color: var(--color-header-text);
	}

	.btn--hero-secondary:hover {
		background: rgb(255 255 255 / 0.1);
		border-color: var(--color-header-text);
		color: var(--color-header-text);
	}

	.catalog-intro__visual {
		display: none;
		place-items: center;
		min-height: 19rem;
		padding: var(--space-8);
		background: var(--color-surface);
		border: 8px solid rgb(255 255 255 / 0.14);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-md);
		color: var(--color-header);
		text-align: center;
		transform: rotate(1.5deg);
	}

	.catalog-intro__visual-mark {
		display: grid;
		place-items: center;
		width: 7rem;
		height: 7rem;
		margin-bottom: var(--space-4);
		background: var(--color-accent);
		border-radius: var(--radius-lg);
		color: var(--color-accent-contrast);
		font-size: 4rem;
		font-weight: 800;
		line-height: 1;
	}

	.catalog-intro__visual > span:not(.catalog-intro__visual-mark) {
		font-size: var(--text-2xl);
		font-weight: 800;
		letter-spacing: 0.12em;
	}

	.catalog-intro__visual small {
		color: var(--color-muted);
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.brand-grid,
	.category-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.brand-grid > li,
	.category-grid > li {
		display: flex;
	}

	.brand-grid > li > :global(*),
	.category-grid > li > :global(*) {
		flex: 1;
	}

	.section--subtle {
		padding-block: var(--space-10);
		background: var(--color-surface-muted);
		border-block: 1px solid var(--color-border);
	}

	@media (min-width: 40rem) {
		.brand-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.category-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.catalog-intro__inner {
			grid-template-columns: minmax(0, 1.35fr) minmax(19rem, 0.65fr);
		}

		.catalog-intro__visual {
			display: grid;
		}

		.brand-grid {
			grid-template-columns: repeat(5, minmax(0, 1fr));
		}

		.category-grid {
			grid-template-columns: repeat(8, minmax(0, 1fr));
		}
	}
</style>
