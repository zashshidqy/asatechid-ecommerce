---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { resolveSiteOrigin } from "../utils/site-url";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const settings = await getSiteSettings();
const { siteTitle } = resolveStarterSiteIdentity(settings);
const siteOrigin = resolveSiteOrigin({
	url: Astro.url,
	settingsUrl: settings.url,
	configUrl: Astro.locals.emdash?.config?.siteUrl,
});

const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: siteOrigin,
	titleSeparator: settings.seo?.titleSeparator ?? " — ",
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<Container>
		<Breadcrumbs
			items={[{ label: "Beranda", href: "/" }, { label: page.data.title }]}
		/>

		<article class="content-page">
			<header class="page-head content-page__head">
				<p class="page-head__eyebrow">Informasi</p>
				<h1 {...page.edit.title}>{page.data.title}</h1>
			</header>

			<div class="prose content-page__body">
				<PortableText value={page.data.content} />
			</div>
		</article>
	</Container>
</Base>

<style>
	.content-page {
		max-width: 52rem;
		padding: clamp(var(--space-5), 4vw, var(--space-10));
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-top: 4px solid var(--color-accent);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-card);
	}

	.content-page__head {
		margin-bottom: var(--space-8);
		padding-bottom: var(--space-5);
		border-bottom: 1px solid var(--color-border);
	}

	.content-page__body {
		max-width: 46rem;
	}
</style>
