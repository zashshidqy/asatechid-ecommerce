---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { resolveSiteOrigin } from "../utils/site-url";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const settings = await getSiteSettings();
const { siteTitle } = resolveStarterSiteIdentity(settings);
const siteOrigin = resolveSiteOrigin({
	url: Astro.url,
	settingsUrl: settings.url,
	configUrl: Astro.locals.emdash?.config?.siteUrl,
});

const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: siteOrigin,
	titleSeparator: settings.seo?.titleSeparator ?? " — ",
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<Container>
		<Breadcrumbs
			items={[{ label: "Beranda", href: "/" }, { label: page.data.title }]}
		/>

		<header class="page-head">
			<h1 {...page.edit.title}>{page.data.title}</h1>
		</header>

		<div class="prose">
			<PortableText value={page.data.content} />
		</div>
	</Container>
</Base>
