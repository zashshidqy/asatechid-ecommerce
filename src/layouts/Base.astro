---
import { getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Optional class on <main> for page-specific layout. */
	mainClass?: string;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	content,
	mainClass,
} = Astro.props;

const { data: settings, cacheHint } = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle, siteTagline, siteLogo } =
	resolveStarterSiteIdentity(settings);

const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<a class="skip-link" href="#main">Lewati ke konten utama</a>

		<SiteHeader
			siteTitle={siteTitle}
			siteLogo={siteLogo}
			searchCollections={["products", "posts", "pages"]}
		/>

		<main id="main" class:list={["site-main", mainClass]}>
			<slot />
		</main>

		<SiteFooter
			siteTitle={siteTitle}
			siteTagline={siteTagline}
			siteLogo={siteLogo}
		/>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
