{
  "name": "asatechid-commerce",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "astro check",
    "test": "node --experimental-strip-types --test \"src/lib/**/*.test.ts\"",
    "audit:site": "node scripts/site-audit.mjs",
    "check:launch": "node --experimental-strip-types scripts/launch-check.ts",
    "check:launch:staging": "node --experimental-strip-types scripts/launch-check.ts --staging"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^7.0.0",
    "@emdash-cms/blocks": "^1.3.1",
    "astro": "^7.4.2",
    "emdash": "^1.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "packageManager": "npm@10.9.7"
}
