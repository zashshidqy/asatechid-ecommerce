# Copy to .env and replace with a real generated key:
#   npx emdash secrets generate --write .env
#
# Never commit the real .env file.
EMDASH_ENCRYPTION_KEY=replace-with-output-of-emdash-secrets-generate

# Public origin used for canonical URLs, Open Graph URLs, sitemap, and robots.txt.
# Leave unset locally to fall back to the request origin. Set this to the real
# HTTPS origin in production (for example https://www.example.com).
# EMDASH_SITE_URL=https://www.example.com
